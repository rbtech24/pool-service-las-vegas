{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/posts/:slug",
      "destination": "/blog/posts/:slug",
      "permanent": true
    },
    {
      "source": "/posts/:slug.html",
      "destination": "/blog/posts/:slug",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/index",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/posts/:slug.html",
      "destination": "/blog/posts/:slug",
      "permanent": true
    },
    {
      "source": "/blog/posts/vegas-pool-chemistry-in-july",
